#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

/ {

    behaviors {

   

   erm0_hid: behavior_output_config_erm0_transport {
                        compatible = "zmk,behavior-output-config";
                        #binding-cells = <0>; 
                        device = <&erm0>;
                        source = "layer-state-change";
                         // force = <0>;
  };



   rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&layer0_rgb>, <&layer0_rgb>;
        };

        rgb1_encoder: rgb1_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&layer1_rgb>, <&layer1_rgb>;
        };

        rgb2_encoder: rgb2_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&layer2_rgb>, <&layer2_rgb>;
        };

        rgb3_encoder: rgb3_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&layer3_rgb>, <&layer3_rgb>;
        };
};

    rgb_ug_colors {
        compatible = "zmk,rgb-underglow-colors";
        layer_1 {
            label = "layer_1";
            color = <255 0 0>;    // Red for Layer 0
        };
        layer_2 {
            label = "layer_2";
            color = <0 255 0>;    // Green for Layer 1
        };
        layer_3 {
            label = "layer_3";
            color = <0 0 255>;    // Blue for Layer 2
        };
    };

    macros {
        finder_home: finder_home {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &kp LEFT_COMMAND>,
                <&macro_press &kp LEFT_SHIFT>,
                <&macro_tap &kp H>,
                <&macro_release &kp LEFT_COMMAND>,
                <&macro_release &kp LEFT_SHIFT>;
        };
        finder_desktop: finder_desktop {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &kp LEFT_COMMAND>,
                <&macro_press &kp LEFT_SHIFT>,
                <&macro_tap &kp D>,
                <&macro_release &kp LEFT_COMMAND>,
                <&macro_release &kp LEFT_SHIFT>;
        };

        layer0_rgb: layer0_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&to 1>,
                <&erm0_hid>,
                <&rgb_ug RGB_COLOR_HSB(128,100,100)>;
        };

        layer1_rgb: layer1_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&to 2>,
                <&erm0_hid>,
                <&rgb_ug RGB_COLOR_HSB(240,100,100)>;
        };

        layer2_rgb: layer2_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&to 3>,
                <&erm0_hid>,
                <&rgb_ug RGB_COLOR_HSB(60,100,100)>;
        };

        layer3_rgb: layer3_rgb {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <10>;
            bindings =
                <&to 0>,
                <&erm0_hid>,
                <&rgb_ug RGB_COLOR_HSB(0,100,100)>;
        };

        haptic_feedback: haptic_feedback {
                compatible = "zmk,behavior-macro";
                #binding-cells = <0>;
                wait-ms = <0>;
                tap-ms = <10>;
                bindings = <
                    &erm0_hid
                >;
};


        finder_downloads: finder_downloads {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings =
                <&macro_press &kp LEFT_COMMAND>,
                <&macro_press &kp LEFT_ALT>,
                <&macro_tap &kp L>,
                <&macro_release &kp LEFT_COMMAND>,
                <&macro_release &kp LEFT_ALT>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
                &finder_home       &finder_desktop      &layer0_rgb     &rgb_ug RGB_EFF
                &kp C_VOL_UP       &kp C_MUTE           &kp C_VOL_DN    &rgb_ug RGB_COLOR_HSB(0,100,100)
                &kp C_PREV         &kp C_PLAY_PAUSE     &kp C_NEXT      &none
                &kp C_MUTE         &kp ENTER            &kp ESC         &kp C_MUTE
            >;
            output-config-bindings = <&erm0_hid>;
            sensor-bindings = <
                &rgb_encoder   
                &inc_dec_kp PG_UP PG_DN      // Encoder 2
                &inc_dec_kp C_VOL_UP C_VOL_DN // Encoder 3
            >;
        };

        layer_1 {
            bindings = <
                &bootloader        &none                &layer1_rgb         &rgb_ug RGB_EFF
                &none              &none                &bt BT_CLR          &rgb_ug RGB_COLOR_HSB(128,100,100)
                &bt BT_SEL 0       &bt BT_SEL 1         &kp C_MUTE          &none
                &kp C_MUTE         &kp ENTER            &kp ESC             &kp C_MUTE
            >;
            output-config-bindings = <&erm0_hid>;
            sensor-bindings = <
                &rgb1_encoder            
                &inc_dec_kp PG_UP PG_DN      // Encoder 2
                &inc_dec_kp C_VOL_UP C_VOL_DN // Encoder 3
            >;
        };

        layer_2 {
            bindings = <
                &bootloader        &none                &layer2_rgb         &rgb_ug RGB_EFF
                &none              &none                &bt BT_CLR          &rgb_ug RGB_COLOR_HSB(128,100,100)
                &bt BT_SEL 0       &bt BT_SEL 1         &kp C_MUTE          &none
                &kp C_MUTE         &kp ENTER            &kp ESC             &kp C_MUTE
            >;
            output-config-bindings = <&erm0_hid>;
            sensor-bindings = <
               &rgb2_encoder          
                &inc_dec_kp PG_UP PG_DN      // Encoder 2
                &inc_dec_kp C_VOL_UP C_VOL_DN // Encoder 3
            >;
        };

        layer_3 {
            bindings = <
                &bootloader        &none                &layer3_rgb         &rgb_ug RGB_EFF
                &none              &none                &bt BT_CLR          &rgb_ug RGB_COLOR_HSB(128,100,100)
                &bt BT_SEL 0       &bt BT_SEL 1         &kp C_MUTE          &none
                &kp C_MUTE         &kp ENTER            &kp ESC             &kp C_MUTE
            >;
            output-config-bindings = <&erm0_hid>;
            sensor-bindings = <
               &rgb3_encoder       
                &inc_dec_kp PG_UP PG_DN      // Encoder 2
                &inc_dec_kp C_VOL_UP C_VOL_DN // Encoder 3
            >;
        };

    };
};
